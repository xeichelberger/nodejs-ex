{
  "name": "reel-insight-engine",
  "version": "1.0.0",
  "description": "Analyze IG Reels & YouTube videos for ecomm/marketing/AI insights and manage an idea backlog",
  "main": "dist/index.js",
  "bin": {
    "reel-insight": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
