<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SEO Bot Dashboard</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: #0f172a; color: #e2e8f0; line-height: 1.6; }
    .container { max-width: 1200px; margin: 0 auto; padding: 20px; }

    header { display: flex; justify-content: space-between; align-items: center; padding: 20px 0; border-bottom: 1px solid #1e293b; margin-bottom: 30px; }
    header h1 { font-size: 24px; color: #f8fafc; }
    header h1 span { color: #38bdf8; }
    .status-badge { padding: 4px 12px; border-radius: 12px; font-size: 12px; font-weight: 600; }
    .status-ok { background: #065f46; color: #6ee7b7; }
    .status-warn { background: #78350f; color: #fcd34d; }

    .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin-bottom: 30px; }

    .card { background: #1e293b; border-radius: 12px; padding: 24px; border: 1px solid #334155; }
    .card h2 { font-size: 14px; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 12px; }
    .card .value { font-size: 36px; font-weight: 700; color: #f8fafc; }
    .card .subtitle { font-size: 13px; color: #64748b; margin-top: 4px; }

    .card-full { grid-column: 1 / -1; }
    .card h3 { font-size: 18px; color: #f8fafc; margin-bottom: 16px; }

    table { width: 100%; border-collapse: collapse; }
    th { text-align: left; padding: 10px 12px; font-size: 12px; color: #64748b; text-transform: uppercase; letter-spacing: 0.05em; border-bottom: 1px solid #334155; }
    td { padding: 10px 12px; font-size: 14px; border-bottom: 1px solid #1e293b; }
    tr:hover td { background: #334155; }

    .score { display: inline-block; padding: 2px 10px; border-radius: 8px; font-weight: 600; font-size: 13px; }
    .score-good { background: #065f46; color: #6ee7b7; }
    .score-ok { background: #78350f; color: #fcd34d; }
    .score-bad { background: #7f1d1d; color: #fca5a5; }

    .badge { display: inline-block; padding: 2px 8px; border-radius: 6px; font-size: 11px; font-weight: 600; }
    .badge-critical { background: #7f1d1d; color: #fca5a5; }
    .badge-warning { background: #78350f; color: #fcd34d; }
    .badge-info { background: #1e3a5f; color: #93c5fd; }

    .change-up { color: #6ee7b7; }
    .change-down { color: #fca5a5; }
    .change-stable { color: #64748b; }

    .actions { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 30px; }
    .btn { padding: 10px 20px; border-radius: 8px; border: none; cursor: pointer; font-size: 14px; font-weight: 600; transition: all 0.2s; }
    .btn-primary { background: #2563eb; color: white; }
    .btn-primary:hover { background: #1d4ed8; }
    .btn-secondary { background: #334155; color: #e2e8f0; border: 1px solid #475569; }
    .btn-secondary:hover { background: #475569; }

    .section { margin-bottom: 40px; }
    .section-title { font-size: 20px; color: #f8fafc; margin-bottom: 16px; padding-bottom: 8px; border-bottom: 1px solid #334155; }

    .api-ref { background: #1e293b; border-radius: 8px; padding: 16px; margin-bottom: 10px; border: 1px solid #334155; }
    .api-ref code { color: #38bdf8; font-size: 13px; }
    .api-ref .method { display: inline-block; padding: 2px 8px; border-radius: 4px; font-size: 11px; font-weight: 700; margin-right: 8px; }
    .method-get { background: #065f46; color: #6ee7b7; }
    .method-post { background: #1e3a5f; color: #93c5fd; }
    .method-put { background: #78350f; color: #fcd34d; }
    .api-ref .desc { color: #94a3b8; font-size: 13px; margin-top: 4px; }

    .empty-state { text-align: center; padding: 60px 20px; color: #64748b; }
    .empty-state h3 { color: #94a3b8; margin-bottom: 8px; }

    #loading { display: none; position: fixed; top: 20px; right: 20px; background: #2563eb; color: white; padding: 10px 20px; border-radius: 8px; font-size: 14px; z-index: 100; }
  </style>
</head>
<body>
  <div class="container">
    <header>
      <h1><span>SEO</span> Bot Dashboard</h1>
      <div>
        <span class="status-badge status-ok">System Online</span>
      </div>
    </header>

    <div class="grid">
      <div class="card">
        <h2>Tracked Sites</h2>
        <div class="value" id="site-count">-</div>
        <div class="subtitle">Active sites being monitored</div>
      </div>
      <div class="card">
        <h2>Integrations</h2>
        <div class="value" style="font-size: 18px; margin-top: 10px;">
          <span id="shopify-status">Shopify: --</span><br>
          <span id="gsc-status">GSC: --</span><br>
          <span id="ai-status">Claude AI: --</span>
        </div>
      </div>
      <div class="card">
        <h2>Quick Actions</h2>
        <div style="display: flex; flex-direction: column; gap: 8px; margin-top: 8px;">
          <button class="btn btn-primary" onclick="addSite()">Add Site</button>
          <button class="btn btn-secondary" onclick="location.href='#api-reference'">API Reference</button>
        </div>
      </div>
    </div>

    <div class="section">
      <h2 class="section-title">Tracked Sites</h2>
      <div id="sites-table"></div>
    </div>

    <div class="section" id="api-reference">
      <h2 class="section-title">API Reference</h2>
      <p style="color: #94a3b8; margin-bottom: 16px;">All endpoints require <code style="color: #38bdf8;">X-API-Key</code> header (if API_KEY is set in .env)</p>

      <h3 style="color: #94a3b8; margin: 20px 0 10px;">Sites & Brand Voice</h3>
      <div class="api-ref"><span class="method method-get">GET</span><code>/api/sites</code><div class="desc">List all tracked sites</div></div>
      <div class="api-ref"><span class="method method-post">POST</span><code>/api/sites</code><div class="desc">Add a site: { "url": "https://...", "name": "My Store" }</div></div>
      <div class="api-ref"><span class="method method-get">GET</span><code>/api/sites/:id/voice</code><div class="desc">Get brand voice for a site</div></div>
      <div class="api-ref"><span class="method method-put">PUT</span><code>/api/sites/:id/voice</code><div class="desc">Set brand voice: { "voice_document": "full guide...", "brand_name": "..." } — auto-applied to all content</div></div>

      <h3 style="color: #94a3b8; margin: 20px 0 10px;">SEO Analysis</h3>
      <div class="api-ref"><span class="method method-post">POST</span><code>/api/analysis/page</code><div class="desc">Analyze a single page: { "url": "https://...", "site_id": 1 }</div></div>
      <div class="api-ref"><span class="method method-post">POST</span><code>/api/analysis/site</code><div class="desc">Full site audit: { "site_id": 1, "max_pages": 50 }</div></div>
      <div class="api-ref"><span class="method method-get">GET</span><code>/api/analysis/summary/:site_id</code><div class="desc">Get audit summary for a site</div></div>
      <div class="api-ref"><span class="method method-post">POST</span><code>/api/analysis/sitemap</code><div class="desc">Parse a sitemap: { "url": "https://.../sitemap.xml" }</div></div>

      <h3 style="color: #94a3b8; margin: 20px 0 10px;">Content Generation (Claude AI) — pass site_id to auto-apply brand voice</h3>
      <div class="api-ref"><span class="method method-post">POST</span><code>/api/content/blog-post</code><div class="desc">Generate blog post: { "keyword": "...", "topic": "...", "site_id": 1 } — auto-loads brand voice</div></div>
      <div class="api-ref"><span class="method method-post">POST</span><code>/api/content/meta-description</code><div class="desc">Generate meta descriptions: { "page_title": "...", "keyword": "..." }</div></div>
      <div class="api-ref"><span class="method method-post">POST</span><code>/api/content/product-description</code><div class="desc">Generate product description: { "product_name": "...", "keyword": "...", "brand_voice": "..." }</div></div>
      <div class="api-ref"><span class="method method-post">POST</span><code>/api/content/suggest-improvements</code><div class="desc">Get SEO improvement suggestions for a page</div></div>
      <div class="api-ref"><span class="method method-post">POST</span><code>/api/content/calendar</code><div class="desc">Generate content calendar: { "brand_name": "...", "niche": "..." }</div></div>
      <div class="api-ref"><span class="method method-post">POST</span><code>/api/content/humanize</code><div class="desc">Remove AI tells from any content: { "content": "...", "brand_voice": "..." }</div></div>
      <div class="api-ref"><span class="method method-post">POST</span><code>/api/content/write-from-brief</code><div class="desc">Write article from competitor brief: { "brief": {...}, "brand_name": "..." }</div></div>

      <h3 style="color: #94a3b8; margin: 20px 0 10px;">Competitor Analysis</h3>
      <div class="api-ref"><span class="method method-post">POST</span><code>/api/competitor/crawl</code><div class="desc">Crawl competitor site (Screaming Frog-style): { "url": "...", "max_pages": 200 }</div></div>
      <div class="api-ref"><span class="method method-post">POST</span><code>/api/competitor/top-pages</code><div class="desc">Find competitor's most linked-to pages: { "url": "...", "blog_only": true }</div></div>
      <div class="api-ref"><span class="method method-post">POST</span><code>/api/competitor/analyze-page</code><div class="desc">Deep-analyze a competitor page: { "url": "..." }</div></div>
      <div class="api-ref"><span class="method method-post">POST</span><code>/api/competitor/brief</code><div class="desc">Generate content brief to outperform competitor: { "url": "...", "brand_name": "..." }</div></div>
      <div class="api-ref"><span class="method method-post">POST</span><code>/api/competitor/outperform</code><div class="desc">Full workflow: analyze + brief + write article: { "url": "...", "brand_name": "..." }</div></div>
      <div class="api-ref"><span class="method method-post">POST</span><code>/api/competitor/compare</code><div class="desc">Compare content coverage vs competitor: { "your_url": "...", "competitor_url": "..." }</div></div>

      <h3 style="color: #94a3b8; margin: 20px 0 10px;">Schema Markup Generation</h3>
      <div class="api-ref"><span class="method method-post">POST</span><code>/api/schema/recommend</code><div class="desc">Scan page and recommend schemas to add: { "url": "..." }</div></div>
      <div class="api-ref"><span class="method method-post">POST</span><code>/api/schema/product</code><div class="desc">Generate Product JSON-LD: { "name": "...", "price": 29.99, "rating": 4.5 }</div></div>
      <div class="api-ref"><span class="method method-post">POST</span><code>/api/schema/faq</code><div class="desc">Generate FAQPage JSON-LD: { "faqs": [{"question": "...", "answer": "..."}] }</div></div>
      <div class="api-ref"><span class="method method-post">POST</span><code>/api/schema/article</code><div class="desc">Generate Article JSON-LD: { "title": "...", "author_name": "..." }</div></div>
      <div class="api-ref"><span class="method method-post">POST</span><code>/api/schema/organization</code><div class="desc">Generate Organization JSON-LD: { "name": "...", "url": "..." }</div></div>

      <h3 style="color: #94a3b8; margin: 20px 0 10px;">Reviews & UGC SEO</h3>
      <div class="api-ref"><span class="method method-get">GET</span><code>/api/reviews/audit</code><div class="desc">Audit review SEO across all Shopify products</div></div>
      <div class="api-ref"><span class="method method-post">POST</span><code>/api/reviews/schema</code><div class="desc">Generate Product schema with star ratings for SERPs</div></div>
      <div class="api-ref"><span class="method method-post">POST</span><code>/api/reviews/strategy</code><div class="desc">Get review collection strategy for SEO</div></div>

      <h3 style="color: #94a3b8; margin: 20px 0 10px;">GEO Optimization</h3>
      <div class="api-ref"><span class="method method-post">POST</span><code>/api/geo/audit</code><div class="desc">GEO brand audit: { "brand_name": "...", "site_url": "..." }</div></div>
      <div class="api-ref"><span class="method method-post">POST</span><code>/api/geo/content</code><div class="desc">Generate GEO-optimized content for AI search visibility</div></div>
      <div class="api-ref"><span class="method method-post">POST</span><code>/api/geo/brand-entity</code><div class="desc">Brand entity optimization recommendations</div></div>

      <h3 style="color: #94a3b8; margin: 20px 0 10px;">Internal Linking</h3>
      <div class="api-ref"><span class="method method-post">POST</span><code>/api/linking/analyze</code><div class="desc">Analyze internal link structure: { "site_url": "..." }</div></div>
      <div class="api-ref"><span class="method method-post">POST</span><code>/api/linking/suggestions</code><div class="desc">Get link suggestions: { "site_id": 1 }</div></div>
      <div class="api-ref"><span class="method method-post">POST</span><code>/api/linking/anchor-text</code><div class="desc">Analyze anchor text distribution</div></div>

      <h3 style="color: #94a3b8; margin: 20px 0 10px;">Keywords & SERP Tracking</h3>
      <div class="api-ref"><span class="method method-get">GET</span><code>/api/keywords/:site_id</code><div class="desc">Get all keyword rankings</div></div>
      <div class="api-ref"><span class="method method-post">POST</span><code>/api/keywords/:site_id</code><div class="desc">Add keywords to track: { "keywords": ["kw1", "kw2"] }</div></div>
      <div class="api-ref"><span class="method method-get">GET</span><code>/api/keywords/:site_id/opportunities</code><div class="desc">Get keyword ranking opportunities</div></div>
      <div class="api-ref"><span class="method method-get">GET</span><code>/api/keywords/:site_id/alerts</code><div class="desc">Get ranking change alerts</div></div>

      <h3 style="color: #94a3b8; margin: 20px 0 10px;">Google Search Console</h3>
      <div class="api-ref"><span class="method method-get">GET</span><code>/api/gsc/top-queries</code><div class="desc">Top search queries from GSC</div></div>
      <div class="api-ref"><span class="method method-get">GET</span><code>/api/gsc/top-pages</code><div class="desc">Top pages by clicks from GSC</div></div>
      <div class="api-ref"><span class="method method-get">GET</span><code>/api/gsc/low-ctr</code><div class="desc">Pages with high impressions but low CTR</div></div>
      <div class="api-ref"><span class="method method-get">GET</span><code>/api/gsc/striking-distance</code><div class="desc">Keywords close to page 1 (positions 8-20)</div></div>
      <div class="api-ref"><span class="method method-post">POST</span><code>/api/gsc/sync</code><div class="desc">Sync GSC data: { "site_id": 1 }</div></div>
      <div class="api-ref"><span class="method method-post">POST</span><code>/api/gsc/submit-url</code><div class="desc">Submit URL for indexing: { "url": "https://..." }</div></div>
      <div class="api-ref"><span class="method method-post">POST</span><code>/api/gsc/index-status</code><div class="desc">Check index status of a URL: { "url": "https://..." }</div></div>

      <h3 style="color: #94a3b8; margin: 20px 0 10px;">Shopify</h3>
      <div class="api-ref"><span class="method method-get">GET</span><code>/api/shopify/products/audit</code><div class="desc">Audit all product SEO</div></div>
      <div class="api-ref"><span class="method method-put">PUT</span><code>/api/shopify/products/:id/seo</code><div class="desc">Update product SEO fields</div></div>
      <div class="api-ref"><span class="method method-post">POST</span><code>/api/shopify/blogs/:id/articles</code><div class="desc">Create a blog article</div></div>
      <div class="api-ref"><span class="method method-post">POST</span><code>/api/shopify/pages</code><div class="desc">Create a new page</div></div>
    </div>
  </div>

  <div id="loading">Working...</div>

  <script>
    const API_KEY = '<%= apiKey %>'; // Injected from server config

    function apiHeaders() {
      const headers = { 'Content-Type': 'application/json' };
      if (API_KEY) headers['X-API-Key'] = API_KEY;
      return headers;
    }

    async function loadDashboard() {
      try {
        // Load sites
        const sitesRes = await fetch('/api/sites', { headers: apiHeaders() });
        const sitesData = await sitesRes.json();
        document.getElementById('site-count').textContent = sitesData.sites.length;
        renderSitesTable(sitesData.sites);

        // Load integration statuses
        const [shopifyRes, gscRes] = await Promise.all([
          fetch('/api/shopify/status', { headers: apiHeaders() }).catch(() => ({ json: () => ({ configured: false }) })),
          fetch('/api/gsc/status', { headers: apiHeaders() }).catch(() => ({ json: () => ({ configured: false }) })),
        ]);

        const shopify = await shopifyRes.json();
        const gscStatus = await gscRes.json();

        document.getElementById('shopify-status').innerHTML = `Shopify: ${shopify.configured ? '<span style="color:#6ee7b7">Connected</span>' : '<span style="color:#64748b">Not configured</span>'}`;
        document.getElementById('gsc-status').innerHTML = `GSC: ${gscStatus.configured ? '<span style="color:#6ee7b7">Connected</span>' : '<span style="color:#64748b">Not configured</span>'}`;
        document.getElementById('ai-status').innerHTML = 'Claude AI: <span style="color:#6ee7b7">Ready</span>';
      } catch (err) {
        console.error('Dashboard load error:', err);
      }
    }

    function renderSitesTable(sites) {
      const container = document.getElementById('sites-table');
      if (sites.length === 0) {
        container.innerHTML = '<div class="empty-state"><h3>No sites tracked yet</h3><p>Add your first site to get started with SEO analysis.</p></div>';
        return;
      }

      let html = '<table><thead><tr><th>Site</th><th>URL</th><th>Platform</th><th>Added</th><th>Actions</th></tr></thead><tbody>';
      for (const site of sites) {
        html += `<tr>
          <td><strong>${site.name || site.url}</strong></td>
          <td><a href="${site.url}" target="_blank" style="color:#38bdf8">${site.url}</a></td>
          <td>${site.platform}</td>
          <td>${new Date(site.created_at).toLocaleDateString()}</td>
          <td>
            <button class="btn btn-secondary" style="padding:4px 12px;font-size:12px" onclick="runAudit(${site.id})">Audit</button>
            <button class="btn btn-secondary" style="padding:4px 12px;font-size:12px" onclick="deleteSite(${site.id})">Remove</button>
          </td>
        </tr>`;
      }
      html += '</tbody></table>';
      container.innerHTML = html;
    }

    async function addSite() {
      const url = prompt('Enter site URL (e.g., https://your-store.com):');
      if (!url) return;
      const name = prompt('Enter a name for this site (optional):') || '';

      showLoading();
      try {
        const res = await fetch('/api/sites', {
          method: 'POST',
          headers: apiHeaders(),
          body: JSON.stringify({ url, name }),
        });
        const data = await res.json();
        if (data.error) alert(data.error);
        else loadDashboard();
      } catch (err) {
        alert('Error adding site: ' + err.message);
      }
      hideLoading();
    }

    async function runAudit(siteId) {
      if (!confirm('Run a full SEO audit? This may crawl up to 20 pages.')) return;

      showLoading();
      try {
        const res = await fetch('/api/analysis/site', {
          method: 'POST',
          headers: apiHeaders(),
          body: JSON.stringify({ site_id: siteId, max_pages: 20 }),
        });
        const data = await res.json();
        alert(`Audit complete!\n\nPages analyzed: ${data.audit.summary.total_pages}\nAverage score: ${Math.round(data.audit.summary.average_score)}/100\nCritical issues: ${data.audit.summary.critical_issues}\nWarnings: ${data.audit.summary.warning_issues}`);
      } catch (err) {
        alert('Audit error: ' + err.message);
      }
      hideLoading();
    }

    async function deleteSite(siteId) {
      if (!confirm('Remove this site from tracking?')) return;
      await fetch(`/api/sites/${siteId}`, { method: 'DELETE', headers: apiHeaders() });
      loadDashboard();
    }

    function showLoading() { document.getElementById('loading').style.display = 'block'; }
    function hideLoading() { document.getElementById('loading').style.display = 'none'; }

    loadDashboard();
  </script>
</body>
</html>
