# ===========================================
# SEO Bot Configuration
# ===========================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# Server
PORT=8080
NODE_ENV=development

# API Key for protecting your bot's endpoints (generate a random string)
API_KEY=your-secret-api-key-here

# ===========================================
# Anthropic (Claude) - for content generation
# ===========================================
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ===========================================
# Shopify Integration
# ===========================================
# Get these from your Shopify Admin > Settings > Apps > Develop apps
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=your-shopify-admin-api-access-token

# ===========================================
# Google Search Console
# ===========================================
# Create a service account in Google Cloud Console
# Download the JSON key file and set these values from it
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----"
GOOGLE_SITE_URL=https://your-site.com

# ===========================================
# Cron Schedule (optional - defaults shown)
# ===========================================
# CRON_SEO_AUDIT=0 2 * * 1
# CRON_SERP_CHECK=0 6 * * *
# CRON_CONTENT_SUGGESTIONS=0 8 * * 1
